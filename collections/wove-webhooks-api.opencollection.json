{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wove External Authentication Webhooks API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List webhooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wove.com/api/v1/external/webhooks",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve all configured webhooks for your organization.\n\n## Webhook Events\n\nThe following events can trigger webhooks:\n- `extraction.completed` - Document extraction successful\n- `extraction.failed` - Document extraction failed\n- `validation.completed` - Cross-validation completed\n- `validation.failed` - Cross-validation failed\n- `merge.completed` - Document merge completed\n- `merge.failed` - Document merge failed\n- `document.uploaded` - New document uploaded\n- `document.deleted` - Document dele"
        },
        {
          "info": {
            "name": "Create webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wove.com/api/v1/external/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a new webhook endpoint for receiving notifications.\n\n## Example Payloads\n\n### extraction.completed\n```json\n{\n  \"event\": \"extraction.completed\",\n  \"timestamp\": \"2024-01-15T10:30:00.000Z\",\n  \"data\": {\n    \"document\": { /* WebhookDocument object */ },\n    \"entityType\": \"shipments\",\n    \"entityId\": \"1014560123456789012\"\n  }\n}\n```\n\n### validation.completed\n```json\n{\n  \"event\": \"validation.completed\",\n  \"timestamp\": \"2024-01-15T10:30:00.000Z\",\n  \"data\": {\n    \"jobId\": \"1014560123456789012\",\n   "
        },
        {
          "info": {
            "name": "Get webhook details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wove.com/api/v1/external/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "Unique webhook identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve details of a specific webhook."
        },
        {
          "info": {
            "name": "Update webhook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.wove.com/api/v1/external/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "Unique webhook identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update webhook configuration."
        },
        {
          "info": {
            "name": "Delete webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.wove.com/api/v1/external/webhooks/:webhookId",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "Unique webhook identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Delete a webhook endpoint."
        },
        {
          "info": {
            "name": "Test webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wove.com/api/v1/external/webhooks/:webhookId/test",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "Unique webhook identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Send a test event to the webhook endpoint."
        },
        {
          "info": {
            "name": "Test webhook URL",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.wove.com/api/v1/external/webhooks/test",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Test a webhook URL before creating it."
        },
        {
          "info": {
            "name": "Get webhook deliveries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.wove.com/api/v1/external/webhooks/:webhookId/deliveries",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path",
                "description": "Unique webhook identifier"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of deliveries to return"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve delivery history for a webhook."
        }
      ]
    }
  ],
  "bundled": true
}