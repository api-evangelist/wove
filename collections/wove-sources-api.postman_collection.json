          "id": "f751adae-aee2-4838-9464-830ca3ea2fd5",
          "name": "Get presigned URL for source upload",
          "request": {
            "name": "Get presigned URL for source upload",
            "description": {
              "content": "Creates a new source record and returns a presigned URL for uploading a rate sheet file.\n\n**Workflow**:\n1. Call this endpoint with file metadata\n2. Upload the file directly to the returned presigned URL using PUT\n3. Call POST /sources/{sourceId}/process to start processing\n\n**Supported file types**: Excel (.xlsx, .xls), CSV, PDF\n\n**File size limit**: 50MB\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "external",
                "sources",
                "upload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
