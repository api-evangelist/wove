        {
          "id": "48c56c1c-656f-432d-9306-09b32a8f04c6",
          "name": "Start processing an uploaded source",
          "request": {
            "name": "Start processing an uploaded source",
            "description": {
              "content": "Initiates processing of a source file after it has been uploaded to the presigned URL.\n\nThe source will be queued for processing and its status will transition through:\n- `pending` → `processing` → `complete` or `failed`\n\nUse GET /sources/{sourceId} to monitor processing status.\nConfigure webhooks to receive notifications when processing completes.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "external",
                "sources",
                ":sourceId",
                "process"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
